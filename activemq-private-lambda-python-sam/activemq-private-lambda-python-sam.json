{
  "title": "AWS Lambda function subscribed to an Amazon MQ - Apache ActiveMQ in private subnets (Python)",
  "description": "Creates an AWS Lambda function that uses a private Amazon MQ (Apache ActiveMQ) queue as an event source and writes to Amazon DynamoDB.",
  "language": "Python",
  "level": "200",
  "framework": "AWS SAM",
  "introBox": {
    "headline": "How it works",
    "text": [
      "This pattern provides an AWS Lambda function along with an event source mapping to an Amazon MQ (Apache ActiveMQ) queue located in private subnets.",
      "The AWS CloudFormation template provided in this pattern installs an Amazon MQ (Apache ActiveMQ) cluster in private subnets inside an Amazon VPC, along with an Amazon EC2 client instance.",
      "The function parses each message and stores the result in an Amazon DynamoDB table, logging details to Amazon CloudWatch. For detailed deployment instructions see the README.md."
    ]
  },
  "gitHub": {
    "template": {
      "repoURL": "https://github.com/aws-samples/serverless-patterns/tree/main/activemq-private-lambda-python-sam",
      "templateURL": "serverless-patterns/activemq-private-lambda-python-sam",
      "projectFolder": "activemq-private-lambda-python-sam",
      "templateFile": "activemq_consumer_dynamo_sam/template_original.yaml"
    }
  },
  "resources": {
    "bullets": [
      {
        "text": "Configuring Amazon MQ event source for Lambda",
        "link": "https://docs.aws.amazon.com/lambda/latest/dg/process-mq-messages-with-lambda.html"
      },
      {
        "text": "Using Lambda with Amazon MQ",
        "link": "https://docs.aws.amazon.com/lambda/latest/dg/with-mq.html"
      },
      {
        "text": "Amazon MQ resource type reference",
        "link": "https://docs.aws.amazon.com/AWSCloudFormation/latest/TemplateReference/AWS_AmazonMQ.html"
      }
    ]
  },
  "services": {
    "from": {
      "serviceName": "Amazon MQ",
      "serviceURL": "/amazon-mq/"
    },
    "to": {
      "serviceName": "AWS Lambda",
      "serviceURL": "/lambda/"
    }
  },
  "deploy": {
    "text": [
      "aws cloudformation create-stack --stack-name my-stack --template-body file://ActiveMQAndClientEC2.yaml --capabilities CAPABILITY_IAM --region &lt;AWS_REGION&gt;",
      "cd activemq_consumer_dynamo_sam",
      "sam build",
      "sam deploy --capabilities CAPABILITY_IAM --no-confirm-changeset --no-disable-rollback --region $AWS_REGION --stack-name activemq-lambda-python-sam --guided"
    ]
  },
  "testing": {
    "text": [
      "Send messages to the Amazon MQ (Apache ActiveMQ) queue with the provided script: <code>sh ./commands.sh firstBatch 100</code>.",
      "Confirm the records in Amazon DynamoDB: <code>aws dynamodb scan --table-name ActiveMQDynamoDBTablePython --select \"COUNT\"</code>.",
      "See the README.md for detailed testing instructions."
    ]
  },
  "cleanup": {
    "text": [
      "Delete the SAM stack: <code>cd activemq_consumer_dynamo_sam &amp;&amp; sam delete</code>.",
      "Delete the ActiveMQ/EC2 CloudFormation stack from the AWS CloudFormation console (or <code>aws cloudformation delete-stack --stack-name my-stack</code>)."
    ]
  },
