{
  "title": "Stream Amazon Bedrock completions via AWS AppSync subscriptions",
  "description": "Stream Anthropic Claude responses from Amazon Bedrock to clients with AppSync subscriptions.",
  "language": "TypeScript",
  "level": "200",
  "framework": "AWS CDK",
  "introBox": {
    "headline": "How it works",
    "text": [
      "This pattern takes a prompt from the ask mutation and sends it to Anthropic Claude Haiku 5.5 in Amazon Bedrock from a Lambda resolver, using the ConverseStream API.",
      "As each part of the response arrives, the function calls the send mutation, and clients receive the parts through an AppSync subscription for the corresponding chat ID."
    ]
  },
  "gitHub": {
    "template": {
      "templateFile": "lib/backend-stack.ts"
    }
  },
