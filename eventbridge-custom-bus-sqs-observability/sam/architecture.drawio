        <!-- 3 Handle failures -->
        <mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;rounded=0;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="subscriber" target="dlq">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="268" />
              <mxPoint x="700" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 4 Observe: delivery records -->
        <mxCell id="e4a" value="4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="subscriber" target="logs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4 Observe: metrics -->
        <mxCell id="e4b" value="4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;rounded=0;exitX=0.188;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ebGroup" target="alarms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5 Recover: replay -->
        <mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bus" target="replay">
