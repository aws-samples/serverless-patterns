node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / tooling
.claude/
.vscode/
.idea/

# macOS
.DS_Store

# Local installers (e.g. AWS CLI v2 pkg downloaded during setup) — never commit
*.pkg
