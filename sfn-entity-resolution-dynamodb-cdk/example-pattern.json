        "link": "https://docs.aws.amazon.com/eventbridge/latest/userguide/eb-what-is.html"
      }
    ]
  },
  "deploy": {
    "text": [
      "<code>cd sfn-entity-resolution-dynamodb-cdk/cdk</code>",
